{
  "name": "ssh-cli",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "docs": "bun run scripts/gen-shortcuts.ts",
    "build": "bun run build:win",
    "build:win": "bun build --compile --target=bun-windows-x64 src/index.ts --outfile dist/ssh-cli.exe",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile dist/ssh-cli-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/index.ts --outfile dist/ssh-cli-linux-arm64",
    "build:mac": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile dist/ssh-cli-macos-arm64",
    "build:mac-x64": "bun build --compile --target=bun-darwin-x64 src/index.ts --outfile dist/ssh-cli-macos-x64"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/ssh2": "1.15.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@logtape/logtape": "2.4.2",
    "@opentui/core": "0.6.6",
    "ssh2-no-cpu-features": "2.0.0"
  },
  "optionalDependencies": {
    "@opentui/core-win32-x64": "0.6.6"
  }
}
